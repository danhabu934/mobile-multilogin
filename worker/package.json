{
  "name": "@nexo/android-worker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-runtime.mjs",
    "start": "node dist/server.js",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "predev": "node scripts/copy-runtime.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
