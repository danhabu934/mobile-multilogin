WORKER_API_TOKEN=change-me-with-at-least-32-random-characters
WORKER_ENCRYPTION_KEY=use-a-separate-random-secret-with-at-least-32-characters
WORKER_PORT=8787
WORKER_HOST=127.0.0.1
WORKER_DATA_DIR=/var/lib/nexo-mobile
ANDROID_SDK_ROOT=/opt/android-sdk
ANDROID_AVD_HOME=/var/lib/nexo-mobile/avd
ANDROID_SYSTEM_IMAGE=system-images;android-35;google_apis_playstore;x86_64
ANDROID_DEVICE_ID=pixel_7_pro
ANDROID_HEADLESS=true
ANDROID_EMULATOR_GPU=swiftshader_indirect
ANDROID_EMULATOR_MEMORY_MB=4096
ANDROID_EMULATOR_CORES=4
ANDROID_EMULATOR_HEAP_MB=512
ANDROID_EMULATOR_RESOLUTION=720x1280
ANDROID_EMULATOR_DENSITY=320
ANDROID_MAX_ACTIVE_EMULATORS=1
ANDROID_DRY_RUN=false
